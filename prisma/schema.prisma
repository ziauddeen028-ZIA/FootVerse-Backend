generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Profile {
  id                   String         @id @default(uuid()) @db.Uuid
  email                String         @unique
  fullName             String?        @map("full_name")
  avatarUrl            String?        @map("avatar_url")
  role                 UserRole       @default(player)
  phone                String?
  preferredPosition    String?        @default("Forward") @map("preferred_position")
  jerseyNumber         Int?           @map("jersey_number")
  bio                  String?
  createdAt            DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  matchEvents          MatchEvent[]
  mvpMatches           Match[]        @relation("MatchMVP")
  notifications        Notification[]
  playerStats          PlayerStats[]
  teamMemberships      TeamMember[]
  managedTeams         Team[]
  organizedTournaments Tournament[]     @relation("TournamentOrganizer")
  bestPlayerTournaments Tournament[]   @relation("TournamentBestPlayer")
  joinRequests          TeamJoinRequest[]

  @@map("profiles")
  @@schema("public")
}

model Tournament {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId          String?           @map("organizer_id") @db.Uuid
  bestPlayerId         String?           @map("best_player_id") @db.Uuid
  name                 String
  slug                 String            @unique
  description          String?
  bannerUrl            String?           @map("banner_url")
  logoUrl              String?           @map("logo_url")
  format               TournamentFormat? @default(knockout)
  status               TournamentStatus? @default(draft)
  maxTeams             Int?              @default(16) @map("max_teams")
  registeredTeamsCount Int?              @default(0) @map("registered_teams_count")
  entryFee             Decimal?          @default(0.00) @map("entry_fee") @db.Decimal(10, 2)
  prizePool            Decimal?          @default(0.00) @map("prize_pool") @db.Decimal(10, 2)
  location             String
  city                 String?
  startDate            DateTime?         @map("start_date") @db.Date
  endDate              DateTime?         @map("end_date") @db.Date
  createdAt            DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  matches              Match[]
  playerStats          PlayerStats[]
  teams                Team[]
  organizer            Profile?          @relation("TournamentOrganizer", fields: [organizerId], references: [id], onUpdate: NoAction)
  bestPlayer           Profile?                  @relation("TournamentBestPlayer", fields: [bestPlayerId], references: [id], onUpdate: NoAction)
  joinRequests         TournamentJoinRequest[]

  @@map("tournaments")
  @@schema("public")
}

model Team {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  managerId      String?      @map("manager_id") @db.Uuid
  tournamentId   String?      @map("tournament_id") @db.Uuid
  name           String
  shortName      String       @map("short_name") @db.VarChar(5)
  logoUrl        String?      @map("logo_url")
  primaryColor   String?      @default("#1E50FF") @map("primary_color") @db.VarChar(10)
  secondaryColor String?      @default("#FFFFFF") @map("secondary_color") @db.VarChar(10)
  city           String?
  homeGround     String?      @map("home_ground")
  groupName      String?      @map("group_name")
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  matchEvents    MatchEvent[]
  awayMatches    Match[]      @relation("AwayTeam")
  homeMatches    Match[]      @relation("HomeTeam")
  wonMatches     Match[]      @relation("WinnerTeam")
  members        TeamMember[]
  manager        Profile?     @relation(fields: [managerId], references: [id], onUpdate: NoAction)
  tournament     Tournament?       @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  joinRequests           TeamJoinRequest[]
  tournamentJoinRequests TournamentJoinRequest[]

  @@map("teams")
  @@schema("public")
}

model TeamMember {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String?   @map("team_id") @db.Uuid
  playerId     String?   @map("player_id") @db.Uuid
  jerseyNumber Int?      @map("jersey_number")
  position     String?   @default("Midfielder")
  isCaptain    Boolean?  @default(false) @map("is_captain")
  joinedAt     DateTime? @default(now()) @map("joined_at") @db.Timestamptz(6)
  player       Profile?  @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, playerId])
  @@map("team_members")
  @@schema("public")
}

model Match {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId      String?      @map("tournament_id") @db.Uuid
  homeTeamId        String?      @map("home_team_id") @db.Uuid
  awayTeamId        String?      @map("away_team_id") @db.Uuid
  homeSourceMatchId String?      @map("home_source_match_id") @db.Uuid
  awaySourceMatchId String?      @map("away_source_match_id") @db.Uuid
  homeScore         Int?         @default(0) @map("home_score")
  awayScore         Int?         @default(0) @map("away_score")
  homePenaltyScore  Int?         @map("home_penalty_score")
  awayPenaltyScore  Int?         @map("away_penalty_score")
  tieBreakMethod    String?      @map("tie_break_method")
  winnerTeamId      String?      @map("winner_team_id") @db.Uuid
  status            MatchStatus? @default(scheduled)
  roundName         String?      @default("Group Stage") @map("round_name")
  bracketPosition   Int?         @map("bracket_position")
  matchDate         DateTime     @map("match_date") @db.Timestamptz(6)
  venue             String?
  refereeName       String?      @map("referee_name")
  mvpPlayerId       String?      @map("mvp_player_id") @db.Uuid
  createdAt         DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  events            MatchEvent[]
  awayTeam          Team?        @relation("AwayTeam", fields: [awayTeamId], references: [id], onUpdate: NoAction)
  homeTeam          Team?        @relation("HomeTeam", fields: [homeTeamId], references: [id], onUpdate: NoAction)
  winnerTeam        Team?        @relation("WinnerTeam", fields: [winnerTeamId], references: [id], onUpdate: NoAction)
  mvpPlayer         Profile?     @relation("MatchMVP", fields: [mvpPlayerId], references: [id], onUpdate: NoAction)
  tournament        Tournament?  @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  homeSourceMatch   Match?       @relation("HomeSourceMatch", fields: [homeSourceMatchId], references: [id], onUpdate: NoAction)
  homeNextMatches   Match[]      @relation("HomeSourceMatch")
  awaySourceMatch   Match?       @relation("AwaySourceMatch", fields: [awaySourceMatchId], references: [id], onUpdate: NoAction)
  awayNextMatches   Match[]      @relation("AwaySourceMatch")

  @@map("matches")
  @@schema("public")
}

model MatchEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String?   @map("match_id") @db.Uuid
  teamId    String?   @map("team_id") @db.Uuid
  playerId  String?   @map("player_id") @db.Uuid
  minute    Int
  eventType EventType @map("event_type")
  details   String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  match     Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  player    Profile?  @relation(fields: [playerId], references: [id], onUpdate: NoAction)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("match_events")
  @@schema("public")
}

model PlayerStats {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId      String?     @map("player_id") @db.Uuid
  tournamentId  String?     @map("tournament_id") @db.Uuid
  matchesPlayed Int?        @default(0) @map("matches_played")
  goals         Int?        @default(0)
  assists       Int?        @default(0)
  yellowCards   Int?        @default(0) @map("yellow_cards")
  redCards      Int?        @default(0) @map("red_cards")
  cleanSheets   Int?        @default(0) @map("clean_sheets")
  mvpAwards     Int?        @default(0) @map("mvp_awards")
  rating        Decimal?    @default(7.0) @db.Decimal(3, 1)
  createdAt     DateTime?   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player        Profile?    @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([playerId, tournamentId])
  @@map("player_stats")
  @@schema("public")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String?   @default("info")
  link      String?
  isRead    Boolean?  @default(false) @map("is_read")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile?  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notifications")
  @@schema("public")
}

model TeamJoinRequest {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  playerId  String    @map("player_id") @db.Uuid
  status    String    @default("pending")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player    Profile?  @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("team_join_requests")
  @@schema("public")
}

model TournamentJoinRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId String      @map("tournament_id") @db.Uuid
  teamId       String      @map("team_id") @db.Uuid
  status       String      @default("pending")
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tournamentId, teamId])
  @@map("tournament_join_requests")
  @@schema("public")
}

enum UserRole {
  guest
  player
  team_manager
  organizer
  admin

  @@map("user_role")
  @@schema("public")
}

enum TournamentFormat {
  knockout
  league
  group_stage
  hybrid

  @@map("tournament_format")
  @@schema("public")
}

enum TournamentStatus {
  draft
  registration_open
  ongoing
  completed
  cancelled

  @@map("tournament_status")
  @@schema("public")
}

enum MatchStatus {
  scheduled
  live
  halftime
  fulltime
  postponed
  cancelled

  @@map("match_status")
  @@schema("public")
}

enum EventType {
  goal
  own_goal
  penalty
  yellow_card
  red_card
  substitution
  assist

  @@map("event_type")
  @@schema("public")
}
