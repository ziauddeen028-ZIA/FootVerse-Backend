generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model match_events {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id   String?    @db.Uuid
  team_id    String?    @db.Uuid
  player_id  String?    @db.Uuid
  minute     Int
  event_type event_type
  details    String?
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  matches    matches?   @relation(fields: [match_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles   profiles?  @relation(fields: [player_id], references: [id], onUpdate: NoAction)
  teams      teams?     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model matches {
  id                                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournament_id                     String?        @db.Uuid
  home_team_id                      String?        @db.Uuid
  away_team_id                      String?        @db.Uuid
  home_score                        Int?           @default(0)
  away_score                        Int?           @default(0)
  status                            match_status?  @default(scheduled)
  round_name                        String?        @default("Group Stage")
  match_date                        DateTime       @db.Timestamptz(6)
  venue                             String?
  referee_name                      String?
  mvp_player_id                     String?        @db.Uuid
  created_at                        DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime?      @default(now()) @db.Timestamptz(6)
  match_events                      match_events[]
  teams_matches_away_team_idToteams teams?         @relation("matches_away_team_idToteams", fields: [away_team_id], references: [id], onUpdate: NoAction)
  teams_matches_home_team_idToteams teams?         @relation("matches_home_team_idToteams", fields: [home_team_id], references: [id], onUpdate: NoAction)
  profiles                          profiles?      @relation(fields: [mvp_player_id], references: [id], onUpdate: NoAction)
  tournaments                       tournaments?   @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  title      String
  message    String
  type       String?   @default("info")
  link       String?
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  profiles   profiles? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model player_stats {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id      String?      @db.Uuid
  tournament_id  String?      @db.Uuid
  matches_played Int?         @default(0)
  goals          Int?         @default(0)
  assists        Int?         @default(0)
  yellow_cards   Int?         @default(0)
  red_cards      Int?         @default(0)
  clean_sheets   Int?         @default(0)
  mvp_awards     Int?         @default(0)
  rating         Decimal?     @default(7.0) @db.Decimal(3, 1)
  created_at     DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?    @default(now()) @db.Timestamptz(6)
  profiles       profiles?    @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournaments    tournaments? @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([player_id, tournament_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id                 String          @id @db.Uuid
  email              String          @unique
  full_name          String?
  avatar_url         String?
  role               user_role       @default(player)
  phone              String?
  preferred_position String?         @default("Forward")
  jersey_number      Int?
  bio                String?
  created_at         DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?       @default(now()) @db.Timestamptz(6)
  match_events       match_events[]
  matches            matches[]
  notifications      notifications[]
  player_stats       player_stats[]
  team_members       team_members[]
  teams              teams[]
  tournaments        tournaments[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model team_members {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id       String?   @db.Uuid
  player_id     String?   @db.Uuid
  jersey_number Int?
  position      String?   @default("Midfielder")
  is_captain    Boolean?  @default(false)
  joined_at     DateTime? @default(now()) @db.Timestamptz(6)
  profiles      profiles? @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teams         teams?    @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([team_id, player_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model teams {
  id                                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manager_id                          String?        @db.Uuid
  name                                String
  short_name                          String         @db.VarChar(5)
  logo_url                            String?
  primary_color                       String?        @default("#1E50FF") @db.VarChar(10)
  secondary_color                     String?        @default("#FFFFFF") @db.VarChar(10)
  city                                String?
  home_ground                         String?
  created_at                          DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime?      @default(now()) @db.Timestamptz(6)
  match_events                        match_events[]
  matches_matches_away_team_idToteams matches[]      @relation("matches_away_team_idToteams")
  matches_matches_home_team_idToteams matches[]      @relation("matches_home_team_idToteams")
  team_members                        team_members[]
  profiles                            profiles?      @relation(fields: [manager_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tournaments {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizer_id           String?            @db.Uuid
  name                   String
  slug                   String             @unique
  description            String?
  banner_url             String?
  logo_url               String?
  format                 tournament_format? @default(knockout)
  status                 tournament_status? @default(draft)
  max_teams              Int?               @default(16)
  registered_teams_count Int?               @default(0)
  entry_fee              Decimal?           @default(0.00) @db.Decimal(10, 2)
  prize_pool             Decimal?           @default(0.00) @db.Decimal(10, 2)
  location               String
  city                   String?
  start_date             DateTime?          @db.Date
  end_date               DateTime?          @db.Date
  created_at             DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?          @default(now()) @db.Timestamptz(6)
  matches                matches[]
  player_stats           player_stats[]
  profiles               profiles?          @relation(fields: [organizer_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

enum event_type {
  goal
  own_goal
  penalty
  yellow_card
  red_card
  substitution
  assist

  @@schema("public")
}

enum match_status {
  scheduled
  live
  halftime
  fulltime
  postponed
  cancelled

  @@schema("public")
}

enum tournament_format {
  knockout
  league
  group_stage
  hybrid

  @@schema("public")
}

enum tournament_status {
  draft
  registration_open
  ongoing
  completed
  cancelled

  @@schema("public")
}

enum user_role {
  guest
  player
  team_manager
  organizer
  admin

  @@schema("public")
}
